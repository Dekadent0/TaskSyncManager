PORT=3001

# Public HTTPS base URL for webhook callbacks (no trailing slash).
# Use your ngrok URL, e.g. https://getup-tutu-overstock.ngrok-free.dev
WEBHOOK_PUBLIC_URL=

# Trello Power-Up / app secret from https://trello.com/app-key (used for X-Trello-Webhook HMAC).
TRELLO_WEBHOOK_SECRET=

# Optional fallback Jira secret if not stored per-environment during registration.
JIRA_WEBHOOK_SECRET=

# Optional bearer/query token when Jira cannot send X-Hub-Signature.
# Append ?token=... to the Jira callback URL if you use this.
JIRA_WEBHOOK_TOKEN=

# Set to true to process webhooks triggered by Jira "app" actors (automation/API).
JIRA_WEBHOOK_ALLOW_BOT=false

# Set to true to skip app-actor webhooks with no status change (loop prevention).
JIRA_WEBHOOK_SKIP_APP_USER=false
